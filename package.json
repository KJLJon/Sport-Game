{
  "name": "sport-game",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "serve": "pnpm build && vite preview --port 4173 --strictPort --host",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run --reporter=dot",
    "test:verbose": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "trace": "tsx tools/spec-trace.ts",
    "api": "tsx tools/api-index.ts",
    "spec": "tsx tools/spec-section.ts",
    "next": "tsx tools/next-tasks.ts",
    "progress:check": "tsx tools/progress-check.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "budget": "tsx tools/budget.ts",
    "bench": "tsx tools/bench.ts",
    "balance": "tsx tools/balance.ts",
    "balance:playbook": "tsx tools/balance-playbook.ts",
    "balance:soccer": "tsx tools/balance-soccer.ts",
    "ai:ladder": "tsx tools/ai-regression.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.19.0",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.23.2",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
